import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int tests = sc.nextInt();

        while (tests-- > 0) {
            int n = sc.nextInt();
            Set<Integer> distinct = new HashSet<>();
            for (int i = 0; i < n; i++) {
                distinct.add(sc.nextInt());
            }

            int numDistinct = distinct.size();
            int excess = n - numDistinct;

            if (excess % 2 == 0) {
                System.out.println(numDistinct);
            } else {
                System.out.println(numDistinct - 1);
            }
        }
        sc.close();
    }
}